# Configuração do banco de dados da Central de Ar
#
# DB_MODE:
#   localdb -> SQL Server LocalDB no Windows, login do próprio Windows (padrão)
#   docker  -> SQL Server em container (localhost,1433), usuário sa
DB_MODE=localdb

# Nome do banco (o script sql/00_schema_reconstruido.sql cria "CentralDeAr")
DB_NAME=CentralDeAr

# Senha do usuário sa — usada SOMENTE no modo docker.
# Coloque a senha real apenas no arquivo .env (que não vai para o Git).
DB_PASSWORD=troque_aqui
